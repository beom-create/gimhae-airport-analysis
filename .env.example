# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 .gitignore에 들어 있어 커밋되지 않습니다.
# GitHub Actions에서는 같은 이름으로 레포 Settings → Secrets and variables → Actions에 등록합니다.
# 변수 이름은 Phase 0에서 API 명세를 확인한 뒤 확정합니다 (확인 필요).

# 공공데이터포털 일반 인증키 (한국공항공사 운항정보 API)
DATA_GO_KR_SERVICE_KEY=

# 기상청 ASOS 시간자료 API 인증키 (공공데이터포털이면 위와 같은 키일 수 있음, 확인 필요)
KMA_ASOS_SERVICE_KEY=
